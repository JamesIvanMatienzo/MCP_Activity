# MCP File-Server Connector — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Ngrok auth token (required for HTTPS tunnel mode)
# Get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Bearer token for authenticating MCP clients over SSE/HTTP
# Generate a strong random string for production use
MCP_AUTH_TOKEN=your_secret_token_here

# Server port (default: 3000)
PORT=3000

# Transport mode override (set to "sse" to force SSE+ngrok mode)
# If unset, the server auto-detects based on PM2_HOME
# MCP_TRANSPORT=sse
